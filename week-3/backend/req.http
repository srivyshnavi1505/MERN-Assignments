
### Get all users
GET http://localhost:4000/api/user-api/users

###

### Create user
POST http://localhost:4000/api/user-api/users
Content-Type: application/json

{
  "username": "vysh",
  "password": "vysh123",
  "age": 22
}

###

### Get user by id
GET http://localhost:4000/api/user-api/users/697f966f8661fab0eb451219

###

### Update user by id
PUT http://localhost:4000/api/user-api/users/697f966f8661fab0eb451219
Content-Type: application/json

{
  "username": "ravi_new",
  "age": 23
}

### Delete user by id
DELETE http://localhost:4000/api/user-api/users/697f96618661fab0eb451216

###
POST http://localhost:4000/api/user-api/users/auth
Content-Type: application/json

{
  "username" : "vysh",
  "password" : "vysh123"
}

###req for protected Route 
GET http://localhost:4000/api/user-api/users/test





//products




### Get all products
GET http://localhost:4000/api/products


### Create product
POST http://localhost:4000/api/products
Content-Type: application/json

{
  "pid": 3,
  "productName": "frock",
  "price": 999
}


### Get product by id ( from mongodb)
GET http://localhost:4000/api/products/697f98578661fab0eb451224


### Update product byid
PUT http://localhost:4000/api/products/697f98578661fab0eb451224
Content-Type: application/json

{
  "productName": "Mechanical Keyboard",
  "price": 1299
}



### Delete product by id
DELETE http://localhost:4000/api/products/697f98578661fab0eb451224

### Get product by id (custom)
GET http://localhost:4000/api/products/pid/2
